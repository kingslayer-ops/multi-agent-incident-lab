INCIDENT_LAB_LLM_MODE=mock
INCIDENT_LAB_DB_PATH=data/incident-lab.db
INCIDENT_LAB_LOG_LEVEL=INFO
# Set INCIDENT_LAB_LLM_MODE=openai-compatible to enable these values.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
INCIDENT_LAB_LLM_TIMEOUT=12

# Deterministic telemetry is the default. Set to live to query Prometheus and Loki.
INCIDENT_LAB_TELEMETRY_MODE=mock
INCIDENT_LAB_TELEMETRY_FALLBACK=true

# Prometheus /api/v1/query_range
INCIDENT_LAB_PROMETHEUS_URL=http://prometheus:9090
INCIDENT_LAB_PROMETHEUS_TIMEOUT=5
INCIDENT_LAB_PROMETHEUS_LOOKBACK_SECONDS=900
INCIDENT_LAB_PROMETHEUS_STEP_SECONDS=60
INCIDENT_LAB_PROMETHEUS_SERIES_LIMIT=100
# INCIDENT_LAB_PROMETHEUS_BEARER_TOKEN=
# INCIDENT_LAB_PROMETHEUS_USERNAME=
# INCIDENT_LAB_PROMETHEUS_PASSWORD=
# Optional JSON object of name -> PromQL. Use $service in label values.
# INCIDENT_LAB_PROMETHEUS_QUERIES_JSON={"error_rate":"sum(rate(http_requests_total{service=\"$service\",status=~\"5..\"}[5m]))"}

# Loki /loki/api/v1/query_range
INCIDENT_LAB_LOKI_URL=http://loki:3100
INCIDENT_LAB_LOKI_TIMEOUT=5
INCIDENT_LAB_LOKI_LOOKBACK_SECONDS=900
INCIDENT_LAB_LOKI_LINE_LIMIT=100
INCIDENT_LAB_LOKI_QUERY_TEMPLATE={service_name="$service"} |~ "(?i)(error|exception|timeout|failed)"
# INCIDENT_LAB_LOKI_TENANT_ID=
# INCIDENT_LAB_LOKI_BEARER_TOKEN=
# INCIDENT_LAB_LOKI_USERNAME=
# INCIDENT_LAB_LOKI_PASSWORD=
